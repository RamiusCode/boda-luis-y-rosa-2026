---
// DedicatoriaDespedida.astro - Dedicatoria elegante para despedida
---

<div class="flex justify-center mt-16 bg-gradient-to-r from-[#6F7680] via-[#8E949C] to-[#6F7680]">
    <div
        class="w-full max-w-4xl xl:max-w-7xl px-4 py-6 text-center"
        id="wrapper-dedicatoria"
    >
        <p
            id="texto-dedicatoria"
            class="font-charm text-white text-xl md:text-2xl lg:text-3xl xl:text-3xl leading-snug tracking-wider opacity-0 mb-4"
        >
            ¡Gracias a Dios, porque nos ha hecho un regalo tan grande que no
            tenemos palabras para expresarlo!
        </p>

        <p
            id="referencia-dedicatoria"
            class="font-cormorant text-[#F0DC8C] text-base md:text-xl lg:text-2xl tracking-[0.35em] md:tracking-[0.4em] uppercase opacity-0"
        >
            2 Corintios 9:15
        </p>
    </div>
</div>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    const initDedicatoriaAnim = () => {
        const texto = document.getElementById("texto-dedicatoria");
        const referencia = document.getElementById("referencia-dedicatoria");
        if (!texto || !referencia) return;

        console.log("💝 Iniciando componente Dedicatoria Despedida...");

        // 🎯 ESTADO INICIAL - Todo oculto
        gsap.set(texto, { opacity: 0, x: -50 });
        gsap.set(referencia, { opacity: 0, x: 50 });

        // ✨ ANIMACIÓN QUE SE REPITE AL BAJAR/SUBIR
        ScrollTrigger.create({
            trigger: "#wrapper-dedicatoria",
            start: "top 90%",
            end: "top 20%",

            onEnter: () => {
                // Anima el texto principal primero
                gsap.to(texto, {
                    opacity: 1,
                    x: 0,
                    duration: 1.5,
                    ease: "power3.out",
                });

                // Luego la referencia bíblica
                gsap.to(referencia, {
                    opacity: 1,
                    x: 0,
                    duration: 1.2,
                    delay: 0.3,
                    ease: "power3.out",
                });
            },

            onLeaveBack: () => {
                // Resetea cuando subes
                gsap.to(texto, {
                    opacity: 0,
                    x: -50,
                    duration: 0.4,
                    ease: "power2.in",
                });

                gsap.to(referencia, {
                    opacity: 0,
                    x: 50,
                    duration: 0.4,
                    ease: "power2.in",
                });
            },
        });

        console.log("💝✨ Dedicatoria Despedida activada!");
    };

    document.addEventListener("DOMContentLoaded", initDedicatoriaAnim);
    document.addEventListener("astro:page-load", initDedicatoriaAnim);
</script>
